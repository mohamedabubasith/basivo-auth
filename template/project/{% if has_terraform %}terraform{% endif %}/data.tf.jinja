#############################################################################
# Data stores
#############################################################################

resource "aws_db_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.private[*].id
}

resource "aws_security_group" "database" {
  name        = "${local.name}-db"
  description = "Postgres. Reachable only from this service's compute."
  vpc_id      = aws_vpc.main.id

  # No ingress rules here on purpose. Access is granted by the compute security
  # groups referencing this one, so the allow-list is defined next to the thing
  # being allowed rather than in a list that drifts.
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${local.name}-db" }
}

resource "aws_db_instance" "main" {
  identifier     = local.name
  engine         = "postgres"
  engine_version = var.postgres_version
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db_password.result

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.database.id]

  # Not publicly reachable, ever. The database holds password hashes and audit
  # history; there is no configuration of this service that needs it exposed.
  publicly_accessible = false

  multi_az                = var.multi_az
  backup_retention_period = var.environment == "prod" ? 30 : 7
  backup_window           = "03:00-04:00"
  maintenance_window      = "Mon:04:00-Mon:05:00"

  # A user table is the last thing you want to lose to a fat-fingered destroy.
  deletion_protection       = var.environment == "prod"
  skip_final_snapshot       = var.environment != "prod"
  final_snapshot_identifier = var.environment == "prod" ? "${local.name}-final" : null

  performance_insights_enabled    = var.environment == "prod"
  enabled_cloudwatch_logs_exports = ["postgresql"]

  auto_minor_version_upgrade = true
  apply_immediately          = var.environment != "prod"

  tags = { Name = local.name }
}

#############################################################################
# RDS Proxy
#
# Required for Lambda, optional for ECS.
#
# Lambda gives each concurrent invocation its own execution environment and
# therefore its own connection. At even modest concurrency that exhausts
# Postgres, which caps connections in the low hundreds on small instances. The
# proxy holds one warm pool and multiplexes every function onto it.
#############################################################################

{% if has_lambda -%}
resource "aws_iam_role" "rds_proxy" {
  count = var.use_rds_proxy ? 1 : 0
  name  = "${local.name}-rds-proxy"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "rds.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy" "rds_proxy" {
  count = var.use_rds_proxy ? 1 : 0
  name  = "secrets"
  role  = aws_iam_role.rds_proxy[0].id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["secretsmanager:GetSecretValue"]
      Resource = [aws_secretsmanager_secret.db.arn]
    }]
  })
}

# The proxy authenticates to Postgres itself, so it needs the credentials in
# the shape RDS expects — separate from the application's config secret.
resource "aws_secretsmanager_secret" "db" {
  name                    = "${local.name}-db"
  recovery_window_in_days = var.environment == "prod" ? 30 : 0
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db_password.result
  })
}

resource "aws_db_proxy" "main" {
  count = var.use_rds_proxy ? 1 : 0

  name                   = local.name
  engine_family          = "POSTGRESQL"
  role_arn               = aws_iam_role.rds_proxy[0].arn
  vpc_subnet_ids         = aws_subnet.private[*].id
  vpc_security_group_ids = [aws_security_group.database.id]

  require_tls = true
  # Long enough to survive a slow Argon2 verification without the proxy
  # reclaiming the connection mid-request.
  idle_client_timeout = 1800

  auth {
    auth_scheme = "SECRETS"
    iam_auth    = "DISABLED"
    secret_arn  = aws_secretsmanager_secret.db.arn
  }
}

resource "aws_db_proxy_default_target_group" "main" {
  count         = var.use_rds_proxy ? 1 : 0
  db_proxy_name = aws_db_proxy.main[0].name

  connection_pool_config {
    max_connections_percent      = 90
    max_idle_connections_percent = 50
    connection_borrow_timeout    = 120
  }
}

resource "aws_db_proxy_target" "main" {
  count                  = var.use_rds_proxy ? 1 : 0
  db_instance_identifier = aws_db_instance.main.identifier
  db_proxy_name          = aws_db_proxy.main[0].name
  target_group_name      = aws_db_proxy_default_target_group.main[0].name
}

{% endif -%}
{% if uses_redis -%}
#############################################################################
# ElastiCache
#
# Holds lockout counters, one-time codes and rate limits. Losing it does not
# lose user data, but it does reset every lockout and invalidate outstanding
# one-time codes — so treat an outage as a security event, not just downtime.
#############################################################################

resource "aws_elasticache_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.private[*].id
}

resource "aws_security_group" "cache" {
  name        = "${local.name}-cache"
  description = "Redis. Reachable only from this service's compute."
  vpc_id      = aws_vpc.main.id

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${local.name}-cache" }
}

resource "aws_elasticache_replication_group" "main" {
  replication_group_id = local.name
  description          = "Ephemeral auth state for {{ project_name }}"

  engine         = "redis"
  engine_version = var.redis_version
  node_type      = var.redis_node_type
  port           = 6379

  num_cache_clusters         = var.multi_az ? 2 : 1
  automatic_failover_enabled = var.multi_az
  multi_az_enabled           = var.multi_az

  subnet_group_name  = aws_elasticache_subnet_group.main.name
  security_group_ids = [aws_security_group.cache.id]

  at_rest_encryption_enabled = true
  # NOTE: transit encryption is off so the connection string stays `redis://`.
  # Turning it on means `rediss://` and an auth token — worth doing for
  # production; see docs/security.md.
  transit_encryption_enabled = false

  snapshot_retention_limit = var.environment == "prod" ? 5 : 0
  apply_immediately        = var.environment != "prod"

  tags = { Name = local.name }
}
{%- endif %}
