"""{{ project_name }} — application entrypoint.

Middleware order matters and is not arbitrary. Starlette runs middleware in the
order added for requests and in reverse for responses, so the security-header
middleware is added first to guarantee its headers are attached to *every*
response, including ones short-circuited by CORS, CSRF or the rate limiter.
"""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import structlog
from fastapi import FastAPI, Request, status
from fastapi.responses import JSONResponse
from slowapi.errors import RateLimitExceeded
from slowapi.middleware import SlowAPIMiddleware
from starlette.middleware.cors import CORSMiddleware

from {{ package_module }}.db import dispose_engine, engine
{% if feature_sso -%}
from {{ package_module }}.engine import auth_backends, fastapi_users, oauth_clients
{%- else -%}
from {{ package_module }}.engine import fastapi_users
{%- endif %}
from {{ package_module }}.logging_config import configure_logging
{%- if feature_magic_link %}
from {{ package_module }}.routers import magic_link as magic_link_router
{%- endif %}
{%- if feature_orgs %}
from {{ package_module }}.routers import orgs as orgs_router
{%- endif %}
{%- if feature_otp %}
from {{ package_module }}.routers import otp as otp_router
{%- endif %}
from {{ package_module }}.routers import password as password_router
from {{ package_module }}.routers import session as session_router
{%- if feature_sso %}
from {{ package_module }}.routers import sso as sso_router
{%- endif %}
{%- if feature_totp %}
from {{ package_module }}.routers import totp as totp_router
{%- endif %}
from {{ package_module }}.schemas import HealthResponse, UserCreate, UserRead, UserUpdate
{%- if uses_redis %}
from {{ package_module }}.security import redis_client
{%- endif %}
{%- if transport_cookie %}
from {{ package_module }}.security.headers import CSRFMiddleware, SecurityHeadersMiddleware
{%- else %}
from {{ package_module }}.security.headers import SecurityHeadersMiddleware
{%- endif %}
from {{ package_module }}.security.ratelimit import limiter
{%- if uses_redis %}
from {{ package_module }}.security.redis_client import close_redis
{%- endif %}
from {{ package_module }}.settings import get_settings

logger = structlog.get_logger(__name__)

VERSION = "0.1.0"


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    configure_logging()
    settings = get_settings()
    logger.info(
        "starting",
        project=settings.project_name,
        environment=settings.environment.value,
        version=VERSION,
    )
    yield
{%- if uses_redis %}
    await close_redis()
{%- endif %}
    await dispose_engine()
    logger.info("stopped")


def create_app() -> FastAPI:
    settings = get_settings()

    app = FastAPI(
        title=settings.project_name,
        description="{{ project_description }}",
        version=VERSION,
        lifespan=lifespan,
        # Interactive docs are a map of the attack surface. Off in production
        # unless deliberately re-enabled behind your own authentication.
        docs_url=None if settings.environment.is_production_like else "/docs",
        redoc_url=None if settings.environment.is_production_like else "/redoc",
        openapi_url=None if settings.environment.is_production_like else "/openapi.json",
    )

    app.state.limiter = limiter

    # --- Middleware (added outermost-first) -------------------------------
    app.add_middleware(SecurityHeadersMiddleware)

    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        # Credentials plus a wildcard origin is rejected by browsers and would
        # be a vulnerability if it were not; settings validation blocks the
        # combination outright in production.
        allow_credentials=True,
        allow_methods=["GET", "POST", "PATCH", "DELETE", "OPTIONS"],
        allow_headers=["Authorization", "Content-Type", "X-CSRF-Token"],
        expose_headers=["X-Step-Up-Token", "X-Step-Up-Methods", "X-CSRF-Token", "Retry-After"],
        max_age=600,
    )

{%- if transport_cookie %}
    app.add_middleware(
        CSRFMiddleware,
        # The login and refresh endpoints bootstrap the session, so there is no
        # CSRF cookie to present yet. They are safe to exempt: neither performs
        # a state change an attacker benefits from forging, and both are
        # independently rate limited.
        exempt_paths=frozenset(
            {
                "/auth/login",
                "/auth/refresh",
                "/auth/register",
                "/auth/forgot-password",
                "/auth/reset-password",
            }
        ),
    )
{%- endif %}

    if settings.rate_limit_enabled:
        app.add_middleware(SlowAPIMiddleware)

    # --- Routes -----------------------------------------------------------
    # The engine's auth router is deliberately NOT mounted. Its login route
    # cannot issue a refresh token, cannot be rate limited, and does not know
    # about the second factor — see app.auth.routers.session for the
    # replacement that does all three.
    app.include_router(
        fastapi_users.get_register_router(UserRead, UserCreate),
        prefix="/auth",
        tags=["auth"],
    )
    app.include_router(
        fastapi_users.get_verify_router(UserRead),
        prefix="/auth",
        tags=["auth"],
    )
    # Note: the engine's reset-password router is deliberately NOT mounted.
    # app.auth.routers.password reimplements those two endpoints so that rate
    # limiting, audit logging and the enumeration-safe response shape are under
    # this service's control.
    app.include_router(password_router.router)
    app.include_router(session_router.router)

    app.include_router(
        fastapi_users.get_users_router(UserRead, UserUpdate),
        prefix="/users",
        tags=["users"],
    )

{%- if feature_otp %}
    app.include_router(otp_router.router)
{%- endif %}
{%- if feature_totp %}
    app.include_router(totp_router.router)
{%- endif %}
{%- if feature_orgs %}
    app.include_router(orgs_router.router)
{%- endif %}
{%- if feature_magic_link %}
    app.include_router(magic_link_router.router)
{%- endif %}
{%- if feature_sso %}
    app.include_router(sso_router.router)

    for provider in oauth_clients().values():
        app.include_router(
            fastapi_users.get_oauth_router(
                provider.client,
                auth_backends[0],
                settings.secret_key.get_secret_value(),
                redirect_url=None,
                # Never link an OAuth identity to an existing local account
                # purely because the email addresses match. If the IdP does not
                # verify addresses, that is a one-request account takeover.
                # Linking is done explicitly, by an already-authenticated user.
                associate_by_email=settings.sso_auto_link_verified_emails
                and provider.is_verified_by_default,
                is_verified_by_default=provider.is_verified_by_default,
            ),
            prefix=f"/auth/{provider.name}",
            tags=["sso"],
        )

        app.include_router(
            fastapi_users.get_oauth_associate_router(
                provider.client, UserRead, settings.secret_key.get_secret_value()
            ),
            prefix=f"/auth/associate/{provider.name}",
            tags=["sso"],
        )
{%- endif %}

    # --- Error handling ---------------------------------------------------
    @app.exception_handler(RateLimitExceeded)
    async def rate_limit_handler(request: Request, exc: RateLimitExceeded) -> JSONResponse:
        return JSONResponse(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            content={"detail": "Too many requests. Please slow down."},
            headers={"Retry-After": "60"},
        )

    @app.exception_handler(Exception)
    async def unhandled_handler(request: Request, exc: Exception) -> JSONResponse:
        # Log the detail, return none of it. Stack traces and driver errors in
        # a response body are a reliable source of schema and version disclosure.
        logger.exception("unhandled_error", path=request.url.path, method=request.method)
        return JSONResponse(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            content={"detail": "Internal server error."},
        )

    # --- Operational ------------------------------------------------------
    @app.get("/health", response_model=HealthResponse, tags=["ops"])
    async def health() -> HealthResponse:
        """Dependency-aware readiness probe."""
        from sqlalchemy import text

        database_status = "ok"
        redis_status = "ok"

        try:
            async with engine.connect() as connection:
                await connection.execute(text("SELECT 1"))
        except Exception:  # noqa: BLE001
            database_status = "error"

{%- if uses_redis %}
        try:
            await redis_client.get_redis().ping()
        except Exception:  # noqa: BLE001
            redis_status = "error"
{%- else %}
        # No Redis in this build; ephemeral state lives in the database, whose
        # health is already covered above.
        redis_status = "not-configured"
{%- endif %}

        overall = "ok" if database_status == "ok" and redis_status == "ok" else "degraded"
        return HealthResponse(
            status=overall,
            version=VERSION,
            database=database_status,
            redis=redis_status,
        )

    @app.get("/live", tags=["ops"])
    async def live() -> dict[str, str]:
        """Liveness probe. Must not touch dependencies — a Redis outage should
        not cause the orchestrator to kill otherwise healthy pods."""
        return {"status": "ok"}

    return app


app = create_app()
