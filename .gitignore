# --- secrets: never commit --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# --- tooling ----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

